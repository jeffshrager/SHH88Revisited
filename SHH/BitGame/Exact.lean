import SHH.BitGame.Decision
import SHH.Markov.Hitting

/-!
# Exact expected steps in the three-bit game (generated by `tools/gen_exact.py`)

The game `000 → 001` with the six initial operators, and with one chunk added, `00? → 11?`
(the chunk of `000 → 110`). Each table is checked to satisfy the system for expected steps
(`SHH.Markov.HitSys`), and the chain is checked to be well formed with the goal reachable from
every state, so by `SHH.Markov.hit_unique` each table *is* the vector of expected steps.

The fan effect at the level of a single game: adding the chunk raises the expected steps
for this game at `r = 0` (7 → 133/15) and at `r = 1/2` (19/7 → 752538/208555), and leaves them
at 1 at `r = 1`. Whether learning helps *on average* is a different question (see
`notes/CLAIMS.md` and `tools/bitgame.py`: on the three-bit game every single chunk lowers the
mean expected steps at `r = 0` and `r = 1` and raises it at `r = 1/2`).
-/

namespace SHH.BitGame

open SHH.Markov

/-- The goal `001` and the start `000`. -/
def goal3 : State := [false, false, true]
def start3 : State := [false, false, false]

/-- The initial operators, and the initial operators plus the chunk `00? → 11?`. -/
def opsBase : List Op := initialOps 3
def opsPlus : List Op := initialOps 3 ++ [chunk [false, false, false] [true, true, false]]

/-- The chain of a decision procedure on the three-bit game is well formed: weights
nonnegative and summing to one, successors among the states, and the goal reachable. -/
structure WellFormed (ops : List Op) (r : ℚ) : Prop where
  nn : ∀ x ∈ allStates 3, ∀ yp ∈ stepDist ops r goal3 x, 0 ≤ yp.2
  mass : ∀ x ∈ allStates 3, x ≠ goal3 → ((stepDist ops r goal3 x).map Prod.snd).sum = 1
  closed : ∀ x ∈ allStates 3, ∀ yp ∈ stepDist ops r goal3 x, yp.1 ∈ allStates 3
  reach : ∀ x ∈ allStates 3, reachB (stepDist ops r goal3) goal3 8 x = true

/-- With a well-formed chain, a checked table is the unique vector of expected steps. -/
theorem steps_of_table (ops : List Op) (r : ℚ) (T : State → ℚ) (hw : WellFormed ops r)
    (hT : HitSys (allStates 3) (stepDist ops r goal3) goal3 T) :
    ∀ T', HitSys (allStates 3) (stepDist ops r goal3) goal3 T' → T' start3 = T start3 :=
  fun T' h' => hit_unique _ _ _ T' T (by decide) hw.nn hw.mass hw.closed
    (fun x hx => reachB_sound _ _ 8 x (hw.reach x hx)) h' hT start3 (by decide)

def T_r0_Base : State → ℚ := fun x => (([([false, false, false], (7 : ℚ)), ([false, false, true], (0 : ℚ)), ([false, true, false], (9 : ℚ)), ([false, true, true], (7 : ℚ)), ([true, false, false], (9 : ℚ)), ([true, false, true], (7 : ℚ)), ([true, true, false], (10 : ℚ)), ([true, true, true], (9 : ℚ))] : List (State × ℚ)).lookup x).getD 0

theorem wf_r0_Base : WellFormed opsBase (0 : ℚ) :=
  ⟨by decide +kernel, by decide +kernel, by decide +kernel, by decide +kernel⟩

theorem sys_r0_Base : HitSys (allStates 3) (stepDist opsBase (0 : ℚ) goal3) goal3 T_r0_Base :=
  ⟨by decide +kernel, by decide +kernel⟩

def T_r0_Plus : State → ℚ := fun x => (([([false, false, false], (133/15 : ℚ)), ([false, false, true], (0 : ℚ)), ([false, true, false], (51/5 : ℚ)), ([false, true, true], (23/3 : ℚ)), ([true, false, false], (51/5 : ℚ)), ([true, false, true], (23/3 : ℚ)), ([true, true, false], (166/15 : ℚ)), ([true, true, true], (49/5 : ℚ))] : List (State × ℚ)).lookup x).getD 0

theorem wf_r0_Plus : WellFormed opsPlus (0 : ℚ) :=
  ⟨by decide +kernel, by decide +kernel, by decide +kernel, by decide +kernel⟩

theorem sys_r0_Plus : HitSys (allStates 3) (stepDist opsPlus (0 : ℚ) goal3) goal3 T_r0_Plus :=
  ⟨by decide +kernel, by decide +kernel⟩

def T_rHalf_Base : State → ℚ := fun x => (([([false, false, false], (19/7 : ℚ)), ([false, false, true], (0 : ℚ)), ([false, true, false], (144/35 : ℚ)), ([false, true, true], (19/7 : ℚ)), ([true, false, false], (144/35 : ℚ)), ([true, false, true], (19/7 : ℚ)), ([true, true, false], (179/35 : ℚ)), ([true, true, true], (144/35 : ℚ))] : List (State × ℚ)).lookup x).getD 0

theorem wf_rHalf_Base : WellFormed opsBase (1/2 : ℚ) :=
  ⟨by decide +kernel, by decide +kernel, by decide +kernel, by decide +kernel⟩

theorem sys_rHalf_Base : HitSys (allStates 3) (stepDist opsBase (1/2 : ℚ) goal3) goal3 T_rHalf_Base :=
  ⟨by decide +kernel, by decide +kernel⟩

def T_rHalf_Plus : State → ℚ := fun x => (([([false, false, false], (752538/208555 : ℚ)), ([false, false, true], (0 : ℚ)), ([false, true, false], (961713/208555 : ℚ)), ([false, true, true], (119130/41711 : ℚ)), ([true, false, false], (961713/208555 : ℚ)), ([true, false, true], (119130/41711 : ℚ)), ([true, true, false], (1148478/208555 : ℚ)), ([true, true, true], (896343/208555 : ℚ))] : List (State × ℚ)).lookup x).getD 0

theorem wf_rHalf_Plus : WellFormed opsPlus (1/2 : ℚ) :=
  ⟨by decide +kernel, by decide +kernel, by decide +kernel, by decide +kernel⟩

theorem sys_rHalf_Plus : HitSys (allStates 3) (stepDist opsPlus (1/2 : ℚ) goal3) goal3 T_rHalf_Plus :=
  ⟨by decide +kernel, by decide +kernel⟩

def T_r1_Base : State → ℚ := fun x => (([([false, false, false], (1 : ℚ)), ([false, false, true], (0 : ℚ)), ([false, true, false], (2 : ℚ)), ([false, true, true], (1 : ℚ)), ([true, false, false], (2 : ℚ)), ([true, false, true], (1 : ℚ)), ([true, true, false], (3 : ℚ)), ([true, true, true], (2 : ℚ))] : List (State × ℚ)).lookup x).getD 0

theorem wf_r1_Base : WellFormed opsBase (1 : ℚ) :=
  ⟨by decide +kernel, by decide +kernel, by decide +kernel, by decide +kernel⟩

theorem sys_r1_Base : HitSys (allStates 3) (stepDist opsBase (1 : ℚ) goal3) goal3 T_r1_Base :=
  ⟨by decide +kernel, by decide +kernel⟩

def T_r1_Plus : State → ℚ := fun x => (([([false, false, false], (1 : ℚ)), ([false, false, true], (0 : ℚ)), ([false, true, false], (2 : ℚ)), ([false, true, true], (1 : ℚ)), ([true, false, false], (2 : ℚ)), ([true, false, true], (1 : ℚ)), ([true, true, false], (3 : ℚ)), ([true, true, true], (2 : ℚ))] : List (State × ℚ)).lookup x).getD 0

theorem wf_r1_Plus : WellFormed opsPlus (1 : ℚ) :=
  ⟨by decide +kernel, by decide +kernel, by decide +kernel, by decide +kernel⟩

theorem sys_r1_Plus : HitSys (allStates 3) (stepDist opsPlus (1 : ℚ) goal3) goal3 T_r1_Plus :=
  ⟨by decide +kernel, by decide +kernel⟩

/-- **One chunk can slow a game down** (the fan effect, for a single game). In the game
`000 → 001`, adding the chunk `00? → 11?` raises the expected steps from 7 to 133/15 with no
decision procedure (`r = 0`) and from 19/7 to 752538/208555 with a mediocre one (`r = 1/2`), and
leaves them at 1 with a perfect one (`r = 1`). Every solution of the system has these values. -/
theorem chunk_slows_game :
    (∀ T, HitSys (allStates 3) (stepDist opsBase 0 goal3) goal3 T → T start3 = (7 : ℚ)) ∧
    (∀ T, HitSys (allStates 3) (stepDist opsPlus 0 goal3) goal3 T → T start3 = (133/15 : ℚ)) ∧
    (∀ T, HitSys (allStates 3) (stepDist opsBase (1/2) goal3) goal3 T → T start3 = (19/7 : ℚ)) ∧
    (∀ T, HitSys (allStates 3) (stepDist opsPlus (1/2) goal3) goal3 T → T start3 = (752538/208555 : ℚ)) ∧
    (∀ T, HitSys (allStates 3) (stepDist opsBase 1 goal3) goal3 T → T start3 = (1 : ℚ)) ∧
    (∀ T, HitSys (allStates 3) (stepDist opsPlus 1 goal3) goal3 T → T start3 = (1 : ℚ)) := by
  refine ⟨fun T h => ?_, fun T h => ?_, fun T h => ?_, fun T h => ?_, fun T h => ?_, fun T h => ?_⟩
  · rw [steps_of_table _ _ _ wf_r0_Base sys_r0_Base T h]; decide +kernel
  · rw [steps_of_table _ _ _ wf_r0_Plus sys_r0_Plus T h]; decide +kernel
  · rw [steps_of_table _ _ _ wf_rHalf_Base sys_rHalf_Base T h]; decide +kernel
  · rw [steps_of_table _ _ _ wf_rHalf_Plus sys_rHalf_Plus T h]; decide +kernel
  · rw [steps_of_table _ _ _ wf_r1_Base sys_r1_Base T h]; decide +kernel
  · rw [steps_of_table _ _ _ wf_r1_Plus sys_r1_Plus T h]; decide +kernel

end SHH.BitGame
