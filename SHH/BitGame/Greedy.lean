import SHH.BitGame.Optimal
import SHH.Markov.Hitting

/-!
# With a learned operator, the perfect decision procedure is not optimal (generated)

Four bits, the initial operators plus the chunk `0000 → 1111`, the game `0001 → 1110`. A
shortest path takes three moves (`0001 → 0000 → 1111 → 1110`, `three_step_path`), but the
`r = 1` procedure expects 15/4 moves (`greedy_not_optimal`): from `0001` every one-bit move toward
the goal is equally good by Hamming distance, and only one of them leads to the shortcut. The
paper says the `r = 1` heuristic "only approximates optimal problem solving" (p. 415); this is
a case, exactly. (Generated by `tools/gen_exact.py greedy`.)
-/

namespace SHH.BitGame

open SHH.Markov

def opsG : List Op := initialOps 4 ++ [chunk [false, false, false, false] [true, true, true, true]]
def goalG : State := [true, true, true, false]
def startG : State := [false, false, false, true]

def TG : State → ℚ := fun x => (([([false, false, false, false], (2 : ℚ)), ([false, false, false, true], (15/4 : ℚ)), ([false, false, true, false], (2 : ℚ)), ([false, false, true, true], (3 : ℚ)), ([false, true, false, false], (2 : ℚ)), ([false, true, false, true], (3 : ℚ)), ([false, true, true, false], (1 : ℚ)), ([false, true, true, true], (2 : ℚ)), ([true, false, false, false], (2 : ℚ)), ([true, false, false, true], (3 : ℚ)), ([true, false, true, false], (1 : ℚ)), ([true, false, true, true], (2 : ℚ)), ([true, true, false, false], (1 : ℚ)), ([true, true, false, true], (2 : ℚ)), ([true, true, true, false], (0 : ℚ)), ([true, true, true, true], (1 : ℚ))] : List (State × ℚ)).lookup x).getD 0

theorem sysG : HitSys (allStates 4) (stepDist opsG 1 goalG) goalG TG :=
  ⟨by decide +kernel, by decide +kernel⟩

/-- **The `r = 1` procedure expects 15/4 moves** on `0001 → 1110` with the chunk `0000 → 1111`. -/
theorem greedy_not_optimal (T : State → ℚ) (h : HitSys (allStates 4) (stepDist opsG 1 goalG) goalG T) :
    T startG = (15/4 : ℚ) := by
  have := hit_unique (allStates 4) (stepDist opsG 1 goalG) goalG T TG (by decide)
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (fun x hx => reachB_sound _ _ 16 x (by revert x; decide +kernel)) h sysG startG (by decide)
  rw [this]; decide +kernel

/-- **A three-move path exists**: `0001 → 0000 → 1111 → 1110`. -/
theorem three_step_path :
    apply (flipOp 4 3 true) startG = some [false, false, false, false] ∧
      apply (chunk [false, false, false, false] [true, true, true, true]) [false, false, false, false] = some [true, true, true, true] ∧
      apply (flipOp 4 3 true) [true, true, true, true] = some goalG := by
  decide

end SHH.BitGame
