def MT_r0_Base : State → State → ℚ := fun g s =>
    if False then 0
    else if g = [false, false, false] then M_r0_Base_0 s
    else if g = [false, false, true] then M_r0_Base_1 s
    else if g = [false, true, false] then M_r0_Base_2 s
    else if g = [false, true, true] then M_r0_Base_3 s
    else if g = [true, false, false] then M_r0_Base_4 s
    else if g = [true, false, true] then M_r0_Base_5 s
    else if g = [true, true, false] then M_r0_Base_6 s
    else if g = [true, true, true] then M_r0_Base_7 s
    else 0

/-- The mean expected steps over all games, `Base` operators, `r = (0 : ℚ)`. -/
theorem mean_r0_Base (T : State → State → ℚ)
    (h : ∀ g ∈ allStates 3, HitSys (allStates 3) (stepDist opsBase (0 : ℚ) g) g (T g)) :
    meanSteps T = (58/7 : ℚ) := by
  have e0 := table_unique _ _ [false, false, false] (by decide) _ wf_M_r0_Base_0 sys_M_r0_Base_0 (T [false, false, false]) (h [false, false, false] (by decide))
  have e1 := table_unique _ _ [false, false, true] (by decide) _ wf_M_r0_Base_1 sys_M_r0_Base_1 (T [false, false, true]) (h [false, false, true] (by decide))
  have e2 := table_unique _ _ [false, true, false] (by decide) _ wf_M_r0_Base_2 sys_M_r0_Base_2 (T [false, true, false]) (h [false, true, false] (by decide))
  have e3 := table_unique _ _ [false, true, true] (by decide) _ wf_M_r0_Base_3 sys_M_r0_Base_3 (T [false, true, true]) (h [false, true, true] (by decide))
  have e4 := table_unique _ _ [true, false, false] (by decide) _ wf_M_r0_Base_4 sys_M_r0_Base_4 (T [true, false, false]) (h [true, false, false] (by decide))
  have e5 := table_unique _ _ [true, false, true] (by decide) _ wf_M_r0_Base_5 sys_M_r0_Base_5 (T [true, false, true]) (h [true, false, true] (by decide))
  have e6 := table_unique _ _ [true, true, false] (by decide) _ wf_M_r0_Base_6 sys_M_r0_Base_6 (T [true, true, false]) (h [true, true, false] (by decide))
  have e7 := table_unique _ _ [true, true, true] (by decide) _ wf_M_r0_Base_7 sys_M_r0_Base_7 (T [true, true, true]) (h [true, true, true] (by decide))
  have hT : ∀ g ∈ allStates 3, ∀ s ∈ allStates 3, T g s = MT_r0_Base g s := by
    intro g hg s hs
    rw [allStates_three] at hg
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hg
    rcases hg with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      first | (rw [e0 s hs]; simp [MT_r0_Base]) | (rw [e1 s hs]; simp [MT_r0_Base]) |
        (rw [e2 s hs]; simp [MT_r0_Base]) | (rw [e3 s hs]; simp [MT_r0_Base]) |
        (rw [e4 s hs]; simp [MT_r0_Base]) | (rw [e5 s hs]; simp [MT_r0_Base]) |
        (rw [e6 s hs]; simp [MT_r0_Base]) | (rw [e7 s hs]; simp [MT_r0_Base])
  have : meanSteps T = meanSteps MT_r0_Base := by
    unfold meanSteps
    congr 1
    congr 1
    apply List.flatMap_congr
    intro g hg
    apply List.filterMap_congr
    intro s hs
    split_ifs <;> simp [hT g hg s hs]
  rw [this]
  decide +kernel

